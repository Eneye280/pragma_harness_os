{
  "name": "pragma-harness-os",
  "version": "0.1.0",
  "private": true,
  "description": "Pragma Harness OS — Harness-First desktop control plane",
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter desktop test:coverage",
    "quality-gate": "pnpm -r typecheck && pnpm --filter desktop test:coverage && pnpm --filter harness-core test",
    "dist": "pnpm --filter desktop dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
